{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-skill:orchestrate-multi-perspective-panel:eval-result:v1",
  "title": "Panel Skill Eval Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "suite_revision", "skill_revision", "executed_at", "verified_at", "environment", "cases", "gate"],
  "properties": {
    "suite_version": {"type": "string", "minLength": 1},
    "suite_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "skill_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executed_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "forward_runner", "failure_injection"],
      "properties": {
        "host": {"type": "string", "enum": ["codex", "claude-code", "static-only"]},
        "forward_runner": {"type": "string", "minLength": 16},
        "failure_injection": {"type": "string", "enum": ["real", "simulated", "mixed", "none"]}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "execution", "status", "artifact_path", "artifact_sha256", "run_id", "assertions", "notes"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "execution": {"type": "string", "enum": ["forward", "static", "simulated_failure", "not_run"]},
          "status": {"type": "string", "enum": ["pass", "fail", "not_run"]},
          "artifact_path": {"type": ["string", "null"], "pattern": "^artifacts/[a-z0-9][a-z0-9-]*\\.json$"},
          "artifact_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "run_id": {"type": ["string", "null"], "minLength": 8},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assertion", "status", "evidence"],
              "properties": {
                "assertion": {"type": "string", "minLength": 1},
                "status": {"type": "string", "enum": ["pass", "fail", "not_run"]},
                "evidence": {"type": "string", "minLength": 16}
              }
            }
          },
          "notes": {"type": "string"}
        }
      }
    },
    "gate": {"type": "string", "enum": ["GO", "NO_GO"]}
  }
}
